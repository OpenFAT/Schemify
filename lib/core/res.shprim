schemify 1 shprim
  doc "Resistor: SPICE R element"
  prefix R
  category passive

pin p inout 0 -30
pin n inout 0 30

param value 1k
  kind string
  unit Ohm
  doc "resistance: SPICE value text (a number, an expression, or a value plus device parameters)"
param m 1
  doc "parallel multiplier"

impl spice spice
  format spice "{name} {p} {n} {value} m={m}"

line 0 -30 0 -20
line 0 20 0 30

rect -10 -20 10 20

stext 20 -10 R0 {name}
  size 0.2
stext 20 0 R0 {value}
  size 0.2
