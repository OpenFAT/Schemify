# Schemify "Modern": a records-only theme (config spec §5 Themes), bundled with the editor and
# picked with View → Modern theme or `schemify.opt.theme = "modern"`. It restyles; nodes, keys
# and accelerators are untouched (D25).
# ponytail: one chrome palette (dark) for both canvas themes; add `<selector>.light` variants to
# give the light canvas a light chrome.

# --- tokens: one accent (4c8dff) over neutral greys ----------------------------------------------

color bg 15171b
color surface 1e2127
color raised 23262c
color hover 2a2e35
color active 2f343c
color line 3a3f48
color text d4d7dc
color text-2 c9cdd3
color muted 8b919a
color bright ffffff
color accent-bg 2f4a7a
color accent-fg 7fb0ff
color error ff6b6b

# --- chrome: neutral greys, one accent (4c8dff) -----------------------------------------------------

style *
  fg @text
  accel-fg @muted
  hover-bg @hover
  active-bg @active
  border-color @line

style window
  bg @bg

style menubar
  bg @surface

style menu-title
  hover-bg @hover
  active-bg @active

style menubar-dash
  fg 5a606a

style menubar-button
  bg @surface
  hover-bg @hover

style menu
  bg @raised
  border-color @line

style item
  hover-bg @active

style separator
  fg @line

style toolbar
  bg @surface

style button
  hover-bg @active
  radius 4

style tabs
  bg @surface

style tab
  bg @surface
  fg @muted
  active-bg @active
  active-fg @bright
  border 0

style tab-new
  bg @surface
  fg @muted
  border 0

style canvas
  bg @bg

style status
  bg @surface

style status-field
  bg @bg
  border-color @line

style text_input
  bg @bg
  border-color @line

style text_area
  bg @bg
  border-color @line

style dialog
  bg @raised
  border-color @line
  radius 6

style dialog-button
  bg @active
  hover-bg @line
  radius 4

style ctx-menu
  bg @raised
  border-color @line

style list-row
  hover-bg @active
  active-bg @accent-bg

style keys-panel
  bg @raised

style view-switch
  bg @raised
  border-color @line
  radius 6

style viewsw
  bg @raised
  fg @muted
  hover-bg @active
  hover-fg @bright

style viewsw-on
  bg @accent-bg
  fg @bright
  hover-bg @accent-bg

style viewsw-off
  fg 4a4f57
  hover-bg @raised

# --- docs pane -----------------------------------------------------------------------------------

style docs-pane
  bg @surface
  border-color @line

style docs-bar
  bg @raised

style docs-block-sel
  bg 2a3550

style prose
  fg @text

style docs-var
  bg @raised

style docs-var-name
  fg @accent-fg

style docs-expr
  bg @bg
  border-color @line

style docs-hint
  fg @muted

style docs-plot
  bg @bg
  fg @text-2

style docs-toggle
  border-color @line

style docs-toggle-on
  bg @accent-bg
  fg @bright
  hover-bg @accent-bg
  border-color @accent-bg

style docs-preview-cap
  fg @muted

style docs-preview
  bg 191b20
  border-color @line

style docs-source
  border-color @line

style text-view
  bg @bg

style text-view-body
  fg @text

# --- status colours (meaning, exempt from the accent budget; retuned for dark panels) ----------

style docs-value
  fg 6fcf7f

style docs-value-bad
  fg @error

style docs-unverified
  fg e0a040

style docs-staged-bar
  bg 1f3326
  border-color 3f8f55

style docs-staged
  fg 7fd18f

style activity
  bg @surface

style activity-button
  fg @muted
  hover-bg @hover
  active-bg @active
  active-fg @bright

style dock-hsplit
  bg @hover

style dock-vsplit
  bg @hover

style dock
  bg @surface

style dock-bar
  bg @surface

style dock-title
  fg @muted

style dock-pane
  bg @surface

style dock-note
  fg @muted

style bottom-bar
  bg @raised

style check-error
  fg @error
  hover-bg 3a2226

style check-warning
  fg e0a040
  hover-bg 3a3020

style check-info
  fg @accent-fg

style results-key
  fg @muted

style results-wide
  fg @text

style results-pass
  fg 6fcf7f

style results-fail
  fg @error

style results-dim
  fg 6b717a

style results-yield
  fg @accent-fg

style results-log
  fg @text-2

style results-pick
  bg @raised

style results-pick-sel
  bg @accent-bg

# --- canvas: schemify-theme baseline (gate-checked) ------------------------------------------------

style canvas.dark.0
  fg @bg
style canvas.dark.1
  fg 5aaeea
style canvas.dark.3
  fg @text-2
style canvas.dark.4
  fg 8fc35f
style canvas.dark.5
  fg e2574c
style canvas.dark.grid
  fg 2c3036
style canvas.dark.sel
  fg @bright
style canvas.dark.8
  fg 9406f9
style canvas.dark.9
  fg 06f906
style canvas.dark.10
  fg b8148f
style canvas.dark.12
  fg 7f75f0
style canvas.dark.13
  fg 06f9a8
style canvas.dark.15
  fg c78605
style canvas.dark.17
  fg 14b89c
style canvas.dark.21
  fg e6196e

style canvas.light.0
  fg fbfbfa
style canvas.light.1
  fg 1f5fbf
style canvas.light.3
  fg 1e2126
style canvas.light.4
  fg 2f7d1f
style canvas.light.5
  fg b3261e
style canvas.light.grid
  fg dcdcd8
style canvas.light.sel
  fg 000000
style canvas.light.8
  fg 0606f9
style canvas.light.9
  fg 149cb8
style canvas.light.10
  fg b81474
style canvas.light.12
  fg f906f9
style canvas.light.13
  fg 1c0495
style canvas.light.15
  fg 4e0a5c
style canvas.light.17
  fg 5c180a
style canvas.light.21
  fg 959504

# --- cell settings panel --------------------------------------------------------------------------

style cell-pane
  bg @surface
  border-color @line

style cell-section
  fg @accent-fg

style cell-block
  bg @raised

style cell-key
  fg @muted

style cell-input
  bg @bg
  border-color @line

style cell-body
  bg @bg
  border-color @line
