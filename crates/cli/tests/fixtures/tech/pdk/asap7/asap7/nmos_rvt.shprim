schemify 1 shprim
  doc "asap7 nmos_rvt (N-channel), generated by pdk-manager (pdk spec §2.2)"
  prefix M
  category semiconductor

pin d inout 20 -30
pin g in -20 0
pin s inout 20 30
pin b in 20 0

param model nmos_rvt
  kind string
  doc "the kit's .model name"
param nfin 1
  doc "fins per finger"
param nf 1
  doc "number of fingers"
param m 1
  doc "parallel multiplier"

impl osdi veriloga
  format spice "N{name} {d} {g} {s} {b} {model} nfin={nfin} nf={nf} m={m}"
  file ../../va/code/bsimcmg/vacode/bsimcmg.va

line -20 0 -10 0
line -10 -10 -10 10
  width 2
line -7.5 -10 -7.5 10
  width 2
line -7.5 -10 20 -10
  width 2
line -7.5 10 20 10
  width 2
line 20 -30 20 -10
line 20 10 20 30
line -7.5 0 20 0

poly 17.5 10 12.5 11.875 12.5 8.125
  fill true
  closed true

stext 25 -28 R0 {name}
  size 0.14
stext 25 -19 R0 {model}
  size 0.14
stext 25 4 R0 nfin={nfin}
  size 0.14
