schemify 1 shprim
  category nmos
  prefix X
  provenance "xschem 3.4.4 sky130_fd_pr/nfet_01v8.sym"
  library sky130_fd_pr

pin D inout 20 -30
pin G in -20 0
pin S inout 20 30
pin B in 20 0

param L 0.15
  kind number
  unit um
  min 0.15
param W 1
  kind number
  unit um
param nf 1
  kind int
param ad 0
  computed int((nf+1)/2)*W/nf*0.29
param model nfet_01v8
  kind choice
  choices nfet_01v8 nfet_01v8_lvt

impl spice spice
  format spice "X{name} {D} {G} {S} {B} sky130_fd_pr__{model} L={L} W={W} nf={nf} ad={ad}"
  format cdl "M{name} {D} {G} {S} {B} {model} L={L} W={W}"

line 20 -30 20 -15
line 20 15 20 30
line 4 -15 4 15
line -20 0 4 0

stext 25 -25 R0 {name}
  size 0.2
