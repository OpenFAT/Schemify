schemify 1 shbench
  doc "OTA open-loop AC gain"
  corner tt
  config default

inst 2kq9vd ./ota5t
  at 0 0 R0
  name X1
  Wp 4
inst 6pz0rt core:vsource
  at -300 100 R0
  name V1
  dc vdd

wire 5mhv0q -300 -60 -300 60

label 0zx2fh 80 0 R0 out

var vdd 1.8
  unit V

corner ff
  lib ${PDK_ROOT}/sky130A/libs.tech/combined/sky130.lib.spice ff
  set vdd 1.95
  temp -40
corner tt
  lib ${PDK_ROOT}/sky130A/libs.tech/combined/sky130.lib.spice tt
  set vdd 1.8
  temp 27

config default
  order schematic spice

sweep vsweep
  var vdd
  lin 1.6 2.0 5

output gbw "meas(\"ac\", \"when vdb(out)=0\")"
  unit Hz

spec gbw
  min 10meg

code control spice
  | .control
  |   ac dec 20 1 1G
  |   meas ac gbw when vdb(out)=0
  | .endc
