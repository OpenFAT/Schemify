schemify	1   shcomp
  doc     "6-transistor OTA, NMOS input pair"
	pdk "sky130"
  category "amplifier"

    # --- rank 1: ing here. ---
# pin <name> <dir> <x> <y>= port order
pin INP in -80.000 -20
pin INN in -80 20.0
pin OUT out 80 0
pin IBIAS in -80 40
pin VDD inout 0 -60
pin VSS inout 0 60
param Wp 2
      unit um
      doc "input pair width"
param Lp 0.5
  unit um
impl sch schematic
# --- rad"
  size 0.4
# Wires are geometry only: no net names, so renaming a net never touches them.
wire 0d2k1m 100 -450 -40 -450
inst 4tyd1p sky130:pfet_01v8
  at 120 -480 MR0
  name M4
  W 4
  L 1
wire 7q3vxa 100 -270 100 -190
inst 1j446r sky130:nfet_01v8
  at 120 -300 MR0
  name M2
  W Wp
  L Lp
  nf 2
constraint er  1j446r
  pattern "common-centroid"
# A port connects a schematic net to the rank-1 pin of the same name.
port 5c0d2r -120 -300 R0 INP
port c7rm1e 140 -380 R0 OUT
wire 3fk2a1 -40 -270 -40 -190
inst 4szjc8 sky130:pfet_01v8
  at -60 -480 R0
  name M3
  W 4
  L 1
port fa3k0q -60 -160 R0 IBIAS
wire b8nq0t -40 -190 100 -190
label kq1p4z -40 -380 R0 mirror
port mx0k2p 30 -560 R90 VDD
prose v1d0c5
	| # 5T OTA
	|
	| Gain is $g_m r_o / 2$, with $r_o$ from M2 || M4.
var gm_target "100u"
  unit "S"
  doc "transconductance target"
