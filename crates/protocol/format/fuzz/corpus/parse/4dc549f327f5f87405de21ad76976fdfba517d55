schemify 1 shcomp
  doc "Five-transistor OTA sized by gm/Id: the docs page derives every W from the gmid plugin"
  prefix x

pin inp in -60 -20
pin inn in -60 20
pin out out 60 0
pin vbias in 0 40
pin VDD inout 0 -40
pin VSS inout 20 40

impl sch schematic

line -60 -20 -40 -20
line -60 20 -40 20
line 40 0 60 0
line 0 -40 0 -20
line 0 20 0 40
line 20 10 20 40

poly -40 -40 40 0 -40 40 -40 -40
  closed true

stext -34 -27 R0 +
  size 0.2
stext -34 13 R0 -
  size 0.2
stext -40 -56 R0 {name}
  size 0.25

inst m00001 dev:nfet_01v8
  at 60 300 R0
  name M1
  W W_in
  L L_in
inst m00002 dev:nfet_01v8
  at 300 300 R0
  name M2
  W W_in
  L L_in
