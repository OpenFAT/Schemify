schemify 1 shbench
  doc "two inverter chains, a bus of loads, ignore modes, (fixture)"
  corner tt

inst 0b0001 ./chain
  at 0 0 R0
  name X1
inst 0b0002 ./chain
  at 0 200 R0
  name X2
  size 2
inst 0b0003 ./vsrc
  at -300 0 R0
  name VDD
  dc vdd
inst 0b0004 ./c
  at -400 0 R0
  name VIN
  dc vdd/2
inst 0b0005 ./cap
  at 300 0 R0
  name C[1:0]
  C 10f
inst 0b0009 ./cap
  at 700 0 R0
  name COUT
  FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFl 0n0002 40 0 R0 out
label 0n0003 -40 200 R0 out
label 0n0004 400 30 R0 0
label 0n0013 500 -30 R0 out2
label 0n4001 500 30 R0 outs
label 0n0015 600 -30 R0 out
label 0n0016 600 30 R0 filt
label 0n0017 700 -30 R0 outs
label 0n0018 700 30 R0 0

var vdd 1.8
  unit V
var tstop 2n

corner ff
  lib models.lib ff
  set vdd 1.95
  temp -40
corner tt
  lib models.lib tt
  include extra.inc
  temp 27

code ctl ngspice
  | .control
  | run
  | .endc
code tran spice
  | .tran 1p 2n
