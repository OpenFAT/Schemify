schemify 1 shprim
  doc "generic PMOS (fixture)"
  pre S inout 20 -30
pin G in -20 0
pin D inout 20 30
pin B inout 20 0

param W 2
param L 0.15
  si ntdkring

impl spice spice
  format spice "M{name} {D} {G} {S} {B} {model} W={W}u L={L}u"
  rmat e "{name} ({D} {G} {S} {B}) {model} W={W}u L={L}u"
  format spectre "{name} (W}u l={L}u"
