schemify 1 shcomp
  doc "5-transistor OTA, NMOS input pair"
  category amplifier
  pdk sky130

# --- rank 1: symbol interface. A library browser or netlister stops reading here. ---
# pin <name
port c7rm1e 140 -380 R0 OUT
port fa3k0q -60 -160 R0 IBIAS
port mx0k2p 30 -560 R90 VDD
port qz81ty 30 -100 R270 VSS

text r0m2ve -150 -620 R0 "Gm stage: keep M1/M2 common-centroid"
  size 0.4

constraint s4m3tr match
  member 0gsrp0
  member 1j446r
  pattern common-centroid

prose v1d0c5
  | # 5T OTA
  |
  | Gainshprim is $g_m r_o / 2$, with $r_o$ fr> <dir> <x> <y>; file order = port order
pin INP in -80 -20
pin INN in -80 20
pin OUT out 80 0
pin IBIAS in -80 um
  doc "input pair width"
param Lp 0.5
  unit um

impl sch schematic

# --- rank 2: symbol graphics, draw order ---
poly -60 -50 60 0 -60 50 -60 -50
  closed true

line -80 -20 -60 -20
line -80 20 -60 20
line 60 0 80 0

stext -55 -28 R0 +
stext -55 12 R0 -

# --- rank 3: schematic. Each ki70 -40 -190
wire 7q3vxa 100 -270 100 -190
wire b8nq0t -40 -190 100 -190
wire h2w9cs 100 -430 100 -330

# Net names live only here. Renaming "tail" is a 1-line diff.
label 2ma7xe 30 -190 R0 tail
label kq1p4z -40 -380 R0 mirror

# A port connects a schematic net to the rank-1 pin of the same name.
port 5c0d2r -120 -300 R0 INP
port 8tj4wh 200 -300 R0 INN
port c7rm1e 140 -380 R0 OUT
port fa3k0q -60 -160 R0 IBIAS
port mx0k2p 30 -560 R90 VDD
port qz81ty 30 -100 R270 VSS

text r0m2ve -150 -620 R0 "Gm stage: keep M1/M2 common-centroid"
  size 0.4

constraint s4m3tr match
  member 0gsrp0
  member 1j446r
  patwire 7q3vxa 100 -270 100 -190
wire b8nq0t -40 -190 100 -190
wire h2w9cs 100 -430 100 -330

# Net names live only here. Renaming "tail" is a 1-line diff.
label 2ma7xe 30 -190 R0 tail
label kq1p4z -40 -380 R0 mirror

# A port connects a schematic net to the rank-1 pin of the same name.
port 5c0d2r -120 -300 R0 INP
port 8tj4wh 200 -300 R0 INN
port c7rm1e 140 -380 R0 OUT
port fa3k0q -60 -160 R0 IBIAS
port mx0k2p 30 -560 R90 VDD
port qz81ty 30 -100 R270 VSS

text r0m2ve -150 -620 R0 "Gm stage: keep M1/M2 common-centroid"
  size 0.4

constraint s4m3tr match
  member 0gsrp0
  member 1j446r
  pattern common-centroid

prose v1d0c5
  | # 5T OTA
  |
  | Gainshprim is $g_m r_o / 2$, with $r_o$ from M2 || M4.

var gm_target 100u
  unit S
  doc "transconductance target"
