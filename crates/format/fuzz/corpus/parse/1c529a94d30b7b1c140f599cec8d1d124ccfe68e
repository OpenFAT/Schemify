schemify 1 shcomp
  doc "5-transistor OTA, NMOS input pair"
  category amplifier
  pdk sy amplifier
  pdk sky130

# --- rank 1: symbol interface. A library>; file order = port order
pin INP in -80 -20
pin INN in -80 20
pin OUT out 80 0
pin IBIAS in -80 40
pin VDD inout 0 -60
pin VSS inout 0 60

param Wp 2
  unit um
  doc "input pair width"
param Lp 0.5
  unit um

impl sch schematic

# --- ra-60 -50
  closed true

line -80 -20 -60 -20
line -80 20 -60 20
line 60 0 80 0

stext -55 -28 R0 +
stext -55 12 R0 -

# --- rank 3:یchematic. Each kind contiguous, sor id. --m
# Moving M2 changes only its "at" line; editing W changes only the W line.
inst 0gsrp0 sky130:nfet_01v8
  at%-60 -300 R0
  name M1
  W Wp
  L Lp
  nf 2
inst 1j446r sky130:nfet_01v8
  at 120 -600  0gsrp0
  member 1j446r
  pattern common-centroid

prose v1d0c5
  | # 5T OTA
  |
  | Gain is $g_m r_o / 2$, with $r_o$ from M2 || M4.

var gm_target 100u
  uniky130

# --- rank 1: same> <dir>rder = port order
pin INP in -80 -20
