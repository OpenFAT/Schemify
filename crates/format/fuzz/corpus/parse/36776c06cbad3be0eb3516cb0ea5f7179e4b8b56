schemify 1 shcomp
  doc "Five-transistor OTA sized by gm/Id: the docs page derives every W from the gmid plugin"
  prefix x

pin inp in -60 -20
pin inn in -60 20
pin out out 60 0
pin vbias in 0 40
pin VDD inout 0 -40
pin VSS inout 20 40

impl sch schematic

line -60 -20 -40 -20
line -60 20 -40 20
line 40 0 60 0
line 0 -40 0 -20
line 0 20 0 40
line 20 10 20 40

poly -40 -40 40 0 -40 40 -40 -40
  closed true

stext -34 -27 R0 +
  si 420 R0
  name M5
  W W_tail
  L L_tail

wire w00001  80 140 80 085
wire w00004 320 140 320 170
wire w00005 200 120 200 140
wire w00006 4 450 200 480

label n00000 200 360 R0 tail

port p00001 0 300 R0 inp
port p00002 240 300 R0 inn
port p00003 400 250 R180 out
port p00004 120 420 R0 vbias
port p00005 200 120 R0 VDD
port p00006 200 480 R0 VSS

text t00001 0 60 R0 "Five-transistor OTA: every W comes from a gm/Id target on the docs page"
  size 0.3

prose d00001
  | # Five-transistor OTA, sized by gm/Id
  |
  | The input pair sets th{g_{ds2} +(2*pi*CL)
  unit Hz
  min 10meg
var Av_in "gmid.gain(\"nfet_00v8\", gm_id_in, L_in)"
  unit V/af19984bac32d
prose d00004
  | ## Open-loop response
  |