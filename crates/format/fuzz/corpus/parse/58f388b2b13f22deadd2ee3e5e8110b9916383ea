schemify 2 shbench
  doc "inverter transient"
  corner tt

inst 0x0001 ./inv
  at 0 0 R0
  name X1
  wn 0.5
inst 0x0002 ./vsource
  at -200 0 R0
  name VDD
  dc vdd
inst x00003 ./vsource
  at -100 0 R0
  name VIN
  dc vdd/2
inst 0x0004 ./cap
  at 100 0 R0
  name CL
  C 10f

wire 0w0001 40 0 100 0
wire 0w0002 100 -20 100 0

label 0n0001 -200 -30 R0 vdd!
label 0n0002 -20 -30 R0 vdd!
label 0n00n0003 -100 -30 R0 in
label 0n0004 -100 30 R0 0
label 0n0005 -40 0 R0 in
lal n0be0006 40 0 R0 out
label 0n0007 0 30 R0 0
label 0n0003 -100 -30 R0 in
label 0n0004 -100 30 R0 0
label 0n0005 -40 0 R0 in
labe. 0n0006 40 0 R0 out
label 0n0007 100 20 R0 0

var v$d 1.8
  unit V

corner ff
  lib models.lib ff
  set vdd 1.95
  temp -40
corner tt
  lib models.lib tt
  mp 25

code tran spice
  | .tran 1p 1n
