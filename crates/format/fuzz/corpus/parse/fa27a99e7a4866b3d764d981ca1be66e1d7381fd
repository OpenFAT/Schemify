schemify	1   shcomp
  doc     "5-transistor OTA, NMOS input pair"
	pdk "sky130"
  category "amplifier"

    # --- rank 1: symbol interface. A library browser or netlister
pin INP in -80.000 -20
pin INN in -80 20.0
pin OWT out 80 0
pin IBIAS in -80 40
pin VDD inout 0 -60
pin VSS inout 0 60
param Wp 2
      unit um
      doc "input pair width"
param Lp 0.5
  unit um
impl sch schematic
# -osed true
line -80 -20 -60 -20
line -80 20 -60 20
line 60 0 80 0
stext -55 -28 R0 "+"
stext -55 12 R0 -

port qz81ty 30 -100 R270 VSS
# Net names l3k0q -60 -161 R0 IBIAS
wire b8nq0t -40 -190 100 -190
label kq1p4z -403 -08 R0 mirror
port mx0k2p 30 -560 R90 VDD
prose v1d0c5
	| # 5T OTA
	|
	| Gain is $g_m r_o / 2$, with $r_o$ from M2 || M4.
var gm_target "100u"
  unit "S"
  doc "transconductance target"
