key Alt-R edit.rotate_in_place_selected_objects
key Shift-V edit.vertical_flip_selected_objects
key Shift-F edit.horizontal_flip_selected_objects
key Shift-R edit.rotate_selected_objects
key H edit.constrained_horizontal_move
key V edit.constrained_vertical_move
key E edit.push_schematic
key I edit.push_symbol
key Ctrl+E edit.pop
key Y options.enable_stretch
key Shift-L options.enable_orthogonal_wiring
key Alt-Z options.crosshair.draw_snap_cursor
key Alt-X options.crosshair.draw_crosshair
key % options.draw_grid
key G options.half_snap_threshold
key Shift-G options.double_snap_threshold
key Ctrl+$ options.no_xcopyarea_drawing_model
key : options.netlist_format_symbol_mode.flat_netlist
key Ctrl+Shift+V options.netlist_format_symbol_mode.spice_netlist
key Esc view.redraw
key "\\" view.fullscreen
key F view.zoom_full
key Shift+Z view.zoom_in
key Ctrl+Z view.zoom_out
key Z view.zoom_box
key Shift+O view.toggle_colorscheme
key _ view.toggle_variable_line_width
key Alt+- view.set_line_width
key Ctrl+B view.show_hide.symbol_text
key Q properties.edit
key Shift+Q properties.edit_with_editor
key Ctrl+Shift+Q properties.view
key Shift+T properties.toggle_ignore_attribute_on_selected_inst
key Shift+S properties.change_selected_object_insertion_order
key Shift+B properties.edit_header_license_text
key Alt+Q properties.edit_file_danger
key Ins tools.insert_symbol
key Shift-I tools.insert_symbol
key T tools.insert_text
key W tools.insert_wire
key Shift+W tools.insert_snap_wire
key L tools.insert_line
key R tools.insert_rect
key P tools.insert_polygon
key Shift+C tools.insert_arc
key Ctrl+Shift+C tools.insert_circle
key Print tools.grab_screen_area
key Ctrl+F tools.search
key Alt+U tools.align_to_grid
key & tools.join_trim_wires
key ! tools.break_wires_at_selected_instance_pins
key Ctrl-! tools.remove_wires_running_through_selected_in
key Alt+B symbol.show_symbols.show_symbol_details
key A symbol.make_symbol_from_schematic
key Ctrl+L symbol.make_schematic_from_symbol
key Ctrl+Shift+H symbol.make_schematic_and_symbol_from_selected
