key Ctrl+N file.clear_schematic
key Ctrl+Shift+N file.clear_symbol
key Shift-Ins file.component_browser
key Ctrl-I file.component_browser
key Ctrl+O file.open
key Ctrl+Shift+O file.open_most_recent
key Alt+E file.open_schematic_in_new_window_tab
key Alt+I file.open_symbol_in_new_window_tab
key Shift-D file.delete_files
key Ctrl+S file.save
key B file.merge
key Alt+S file.reload
key Ctrl+Shift+S file.save_as
key Ctrl+Alt+S file.save_as_symbol
key * file.image_export.pdf_ps_export
key Ctrl+* file.image_export.png_export
key Alt+* file.image_export.svg_export
key X file.start_new_xschem_process
key Ctrl+W file.close_schematic
key Ctrl+Q file.quit_xschem
key U edit.undo
key Shift+U edit.redo
key Ctrl+C edit.copy
key Ctrl+X edit.cut
key Ctrl+V edit.paste
key Del edit.delete
key Ctrl+A edit.select_all
key C edit.duplicate_objects
key M edit.move_objects
key Ctrl+M edit.move_objects_stretching_attached_wires
key Shift+M edit.move_objects_adding_wires_to_connected_p
