# Schemify default UI: the xschem-parity shell (D6, D25).
#
# Body of the bundled default-UI plugin's `contribute ui` + `contribute keymap` output
# (plugin-abi §7, format spec §2). Every element below can be overridden by a later plugin with
# `set`, `remove`, `style` or `key` records; last contribution wins (D8).
# Menus, items and accelerators follow docs/xschem-ui/menu-tree.md (xschem 3.4.7, captured live).

# --- theme: one row per selector; class (`style` prop) > kind > `*` -----------------------------

style *
  fg 000000
  font 13
  accel-fg 000000
  hover-bg ececec
  active-bg c3c3c3
  border-color 808080

style window
  bg 000000
  dir column

style menubar
  bg d9d9d9
  dir row
  height 27
  pad 2

style menu-title
  pad 7
  height 23
  hover-bg ececec
  active-bg ececec

style menubar-dash
  fg 6d6d6d
  pad 7

style menubar-button
  bg a3a3a3
  hover-bg b8b8b8
  pad 6
  height 23

style menu
  bg d9d9d9
  border 1
  border-color 8c8c8c
  pad-y 2
  min-width 140

style item
  pad 6
  height 22
  gap 28
  hover-bg ececec

style radio
  radius 6

style separator
  height 9
  fg a3a3a3

style toolbar
  bg ffffff
  dir row
  height 30
  pad 3
  gap 2

style button
  pad 5
  height 24
  font 12
  hover-bg dcdcdc
  radius 3

style spacer
  grow 1

style tabs
  bg c3c3c3
  dir row
  height 23
  pad 1
  gap 2

style tab
  bg d9d9d9
  pad 5
  height 20
  border 1
  active-bg 90ee90

style tab-new
  bg d9d9d9
  pad 4
  height 18
  border 1

style canvas
  grow 1
  bg 000000

style status
  bg d9d9d9
  dir row
  height 26
  pad 4
  gap 6

style status-field
  bg 98fb98
  width 52
  pad 4
  pad-y 1
  border 1

style status-msg
  grow 1

style text_input
  bg ffffff
  pad 4
  pad-y 2
  border 1
  width 120

style dialog
  bg d9d9d9
  dir column
  pad 12
  pad-y 12
  gap 10
  border 1
  border-color 404040

style dialog-input
  width 320

style dialog-button
  bg e4e4e4
  pad 14
  border 1
  radius 2

style dialog-buttons
  dir row
  gap 8

# --- window ---------------------------------------------------------------------------------------

node window window

node menubar menubar
  parent window

# --- menus (generated once from docs/xschem-ui/menu-tree.md, then hand-maintained) ----------------

node menu.file menu
  parent menubar
