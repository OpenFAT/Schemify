# --- tabs -------------------------------------------------------------------------------------------

node tabs tabs
  parent window
node tab.0 tab
  parent tabs
  label poweramp.sch
  checked 1
  command tab.select
node tab.new button
  parent tabs
  label +
  command tab.new
  style tab-new

# --- canvas -----------------------------------------------------------------------------------------

node canvas canvas
  parent window

# --- status bar (SNAP / GRID / MODE as in xschem) ---------------------------------------------------

node status status
  parent window
node status.snap_label label
  parent status
  label SNAP:
node status.snap text_input
  parent status
  value 10
  command view.set_snap
  style status-field
node status.grid_label label
  parent status
  label GRID:
node status.grid text_input
  parent status
  value 20
  command view.set_grid
  style status-field
node status.mode_label label
  parent status
  label MODE:
node status.mode label
  parent status
  label spice
node status.stretch_label label
  parent status
  label Stretch:
node status.stretch label
  parent status
  label 1
node status.msg label
  parent status
  label "selected: 0"
  style status-msg

