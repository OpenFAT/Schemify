# Schemify waveform window (D23): the static skeleton. The rows that follow the viewer tables
# (signals, traces, panes, toggle states, status text) come from `ui::waves::WaveUi::contribute`
# and are composed after this, so a plugin can still restyle or remove anything here (D8).
# Layout follows the UW viewer (D26): expression bar on top, signal browser left, stacked panes
# sharing x in the middle, traces and cursor readout right.

style *
  fg 000000
  font 12
  hover-bg e4e4e4
  active-bg c3c3c3
  border-color 8c8c8c

style window
  bg d9d9d9
  dir column

style toolbar
  bg ececec
  dir row
  height 30
  pad 4
  gap 4

style button
  bg f4f4f4
  pad 6
  height 22
  border 1
  radius 2
  hover-bg ffffff

style checkbox
  pad 4
  height 22
  gap 4

style label
  pad 4

style text_input
  bg ffffff
  pad 4
  pad-y 2
  border 1
  width 120

style wexpr
  width 380

style wfilter
  width 210

style panel
  dir column

style wbody
  dir row
  stretch 1
  grow 1
  pad 4
  gap 4

style wbrowser
  width 222
  gap 4

style wpanes
  grow 1
  gap 4

style wside
  width 270
  gap 4

style wrow
  dir row
  gap 4

style whead
  pad 2
  font 12

style list
  bg ffffff
  border 1
  grow 1

style graph
  grow 1
  bg 000000
  fg a0a0a0

style wreadout
  bg 101010
  fg d0d0d0
  height 190
  border 1

style status
  bg d9d9d9
  dir row
  height 24
  pad 4
  gap 6

style wstatus
  grow 1

node waves window

# --- expression bar and view controls ----------------------------------------------------------

node waves.toolbar toolbar
  parent waves
node waves.expr_label label
  parent waves.toolbar
  label "Expression"
node waves.expr text_input
  parent waves.toolbar
  style wexpr
  command waves.plot
  tooltip "Calculator expression, e.g. db(v(out)/v(in)); Enter plots it"
node waves.plot button
  parent waves.toolbar
  label Plot
  command waves.plot_button
node waves.autoscale button
  parent waves.toolbar
  label "Full (f)"
  command waves.autoscale
node waves.log_x checkbox
  parent waves.toolbar
  label "Log X"
  command waves.log_x
  checked 0
node waves.log_y checkbox
  parent waves.toolbar
  label "Log Y"
  command waves.log_y
  checked 0
node waves.cursor_a checkbox
  parent waves.toolbar
  label "Cursor A"
  command waves.cursor_a
  checked 0
node waves.cursor_b checkbox
  parent waves.toolbar
  label "Cursor B"
  command waves.cursor_b
  checked 0
node waves.add_pane button
  parent waves.toolbar
  label "+ Pane"
  command waves.add_pane
node waves.remove_pane button
  parent waves.toolbar
  label "- Pane"
  command waves.remove_pane

# --- body: browser | panes | traces + readout ---------------------------------------------------

node waves.body panel
  parent waves
  style wbody

node waves.browser panel
  parent waves.body
  style wbrowser
node waves.datasets panel
  parent waves.browser
  style wrow
node waves.dataset_prev button
  parent waves.datasets
  label "<"
  command waves.dataset_prev
node waves.dataset_name label
  parent waves.datasets
  label ""
node waves.dataset_next button
  parent waves.datasets
  label ">"
  command waves.dataset_next
node waves.filter text_input
  parent waves.browser
  style wfilter
  command waves.filter
  tooltip "Filter signals (live)"
node waves.signals list
  parent waves.browser
node waves.browser_buttons panel
  parent waves.browser
  style wrow
node waves.add_signal button
  parent waves.browser_buttons
  label "Add"
  command waves.add_signal
  tooltip "Plot the selected signal (or double-click it)"

node waves.panes panel
  parent waves.body
  style wpanes

node waves.side panel
  parent waves.body
  style wside
node waves.traces_head label
  parent waves.side
  label "Traces"
  style whead
node waves.traces list
  parent waves.side
node waves.trace_buttons panel
  parent waves.side
  style wrow
node waves.delete_trace button
  parent waves.trace_buttons
  label "Delete"
  command waves.delete_trace
node waves.bold button
  parent waves.trace_buttons
  label "Bold"
  command waves.bold
node waves.move_trace button
  parent waves.trace_buttons
  label "Next pane"
  command waves.move_trace
node waves.readout_head label
  parent waves.side
  label "Cursors"
  style whead
node waves.readout panel
  parent waves.side
  style wreadout

node waves.status status
  parent waves
node waves.status_msg label
  parent waves.status
  style wstatus
  label ""

# --- graph properties dialog (spec waves §8): a root, shown by UiState::set_dialog when a plot is
# double-clicked. `WaveUi::contribute` sets the title, the mode/radix labels, the unlock box and
# the `waves.props.f.<k>` field values; Enter in a field or OK applies, Escape or Cancel closes. ---

style dialog
  bg d9d9d9
  dir column
  pad 12
  pad-y 12
  gap 8
  border 1
  border-color 404040

style wfield
  width 96

style wflabel
  pad 4
  width 70

node waves.props dialog
  label "Graph properties"
node waves.props.title label
  parent waves.props
  label "Graph properties"
node waves.props.row0 panel
  parent waves.props
  style wrow
node waves.props.mode button
  parent waves.props.row0
  label "Mode: analog"
  command waves.props.mode
  tooltip "Analog lines, digital lanes, or a histogram of values"
node waves.props.radix button
  parent waves.props.row0
  label "Radix: hex"
  command waves.props.radix
  tooltip "How bus values print"
node waves.props.unlock checkbox
  parent waves.props.row0
  label "Unlock X"
  command waves.props.unlock
  checked 0
  tooltip "Own x axis, not moved with the other panes"

node waves.props.row1 panel
  parent waves.props
  style wrow
node waves.props.l.0 label
  parent waves.props.row1
  label Threshold
  style wflabel
node waves.props.f.0 text_input
  parent waves.props.row1
  command waves.props.ok
  style wfield
  tooltip "Logic 1 at or above this y (digital lanes, bus bits)"
node waves.props.l.1 label
  parent waves.props.row1
  label Bins
  style wflabel
node waves.props.f.1 text_input
  parent waves.props.row1
  command waves.props.ok
  style wfield
  tooltip "Histogram bins, 2 to 1024"
node waves.props.l.2 label
  parent waves.props.row1
  label Step
  style wflabel
node waves.props.f.2 text_input
  parent waves.props.row1
  command waves.props.ok
  style wfield
  tooltip "Sweep step shown (empty: every step)"

node waves.props.row2 panel
  parent waves.props
  style wrow
node waves.props.l.3 label
  parent waves.props.row2
  label "X min"
  style wflabel
node waves.props.f.3 text_input
  parent waves.props.row2
  command waves.props.ok
  style wfield
node waves.props.l.4 label
  parent waves.props.row2
  label "X max"
  style wflabel
node waves.props.f.4 text_input
  parent waves.props.row2
  command waves.props.ok
  style wfield

node waves.props.row3 panel
  parent waves.props
  style wrow
node waves.props.l.5 label
  parent waves.props.row3
  label "Y min"
  style wflabel
node waves.props.f.5 text_input
  parent waves.props.row3
  command waves.props.ok
  style wfield
node waves.props.l.6 label
  parent waves.props.row3
  label "Y max"
  style wflabel
node waves.props.f.6 text_input
  parent waves.props.row3
  command waves.props.ok
  style wfield

node waves.props.row4 panel
  parent waves.props
  style wrow
node waves.props.l.7 label
  parent waves.props.row4
  label "Cursor a"
  style wflabel
node waves.props.f.7 text_input
  parent waves.props.row4
  command waves.props.ok
  style wfield
  tooltip "x of cursor a (empty hides it)"
node waves.props.l.8 label
  parent waves.props.row4
  label "Cursor b"
  style wflabel
node waves.props.f.8 text_input
  parent waves.props.row4
  command waves.props.ok
  style wfield

node waves.props.row5 panel
  parent waves.props
  style wrow
node waves.props.l.9 label
  parent waves.props.row5
  label "Cursor A"
  style wflabel
node waves.props.f.9 text_input
  parent waves.props.row5
  command waves.props.ok
  style wfield
  tooltip "y of horizontal cursor A (empty hides it)"
node waves.props.l.10 label
  parent waves.props.row5
  label "Cursor B"
  style wflabel
node waves.props.f.10 text_input
  parent waves.props.row5
  command waves.props.ok
  style wfield

# Colour swatches (wave::PALETTE, in order): a click recolours the selected trace.
node waves.props.colours panel
  parent waves.props
  style wrow
node waves.props.colours_label label
  parent waves.props.colours
  label "Trace colour"
  style wflabel

style wswatch0
  bg ffd83c
style wswatch1
  bg 3ce6ff
style wswatch2
  bg ff5050
style wswatch3
  bg 6cff5c
style wswatch4
  bg ff9f1a
style wswatch5
  bg c08cff
style wswatch6
  bg 4d94ff
style wswatch7
  bg ff70c8
style wswatch8
  bg ffffff
style wswatch9
  bg a0a0a0
style wswatch10
  bg 00b090
style wswatch11
  bg b8e040
style wswatch12
  bg d8b080
style wswatch13
  bg 9090ff
style wswatch14
  bg ff4080
style wswatch15
  bg 40c0ff

node waves.props.swatch.0 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch0
node waves.props.swatch.1 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch1
node waves.props.swatch.2 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch2
node waves.props.swatch.3 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch3
node waves.props.swatch.4 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch4
node waves.props.swatch.5 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch5
node waves.props.swatch.6 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch6
node waves.props.swatch.7 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch7
node waves.props.swatch.8 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch8
node waves.props.swatch.9 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch9
node waves.props.swatch.10 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch10
node waves.props.swatch.11 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch11
node waves.props.swatch.12 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch12
node waves.props.swatch.13 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch13
node waves.props.swatch.14 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch14
node waves.props.swatch.15 button
  parent waves.props.colours
  label " "
  command waves.props.swatch
  style wswatch15

node waves.props.buttons panel
  parent waves.props
  style wrow
node waves.props.ok button
  parent waves.props.buttons
  label OK
  command waves.props.ok
node waves.props.cancel button
  parent waves.props.buttons
  label Cancel
  command waves.props.cancel

# --- keys: xschem graph keys (inventory §2.2): a, b, s, f, A, B (horizontal cursors), m
# (measurement tooltip), t (dataset tracking), arrows ---------------------------------------------

key a waves.cursor_a
key b waves.cursor_b
key Shift+A waves.hcursor_a
key Shift+B waves.hcursor_b
key s waves.swap_cursors
key f waves.autoscale
key m waves.measure
key t waves.track
key Del waves.delete_trace
key Left waves.pan_left
key Right waves.pan_right
key Up waves.zoom_in
key Down waves.zoom_out
