schemify 1 shprim
  doc "3-bit counter, Verilog model as an inline body (fixture)"
  prefix U

pin clk in -40 0
  domain digital
pin q[2:0] out 40 0
  domain digital

param vdd 1.8
param vth 0.9
param rout 100

impl rtl verilog

body rtl
  | `timescale 1ns/1ps
  | // Counts rising clock edges from 0.
  | module cnt(clk, q);
  |   input clk;
  |   output [2:0] q;
  |   reg [2:0] q;
  |   initial q = 3'd0;
  |   always @(posedge clk) q <= q + 3'd1;
  | endmodule
