schemify 1 shbench
  doc "AC gain of the differential pair: differential (od) and single-ended (outp) at 1 kHz"
  corner tt

inst 0x0001 ./dp
  at 0 0 R0
  name X1

label 0n0001 -40 -20 R0 inp
label 0n0002 -40 20 R0 inn
label 0n0003 40 -20 R0 outp
label 0n0004 40 20 R0 outn
label 0n0005 0 40 R0 tail
label 0n0006 0 -40 R0 0

corner tt
  lib ${PDK_MODELS} tt

config current
  order sch
config post
  cell ./dp pex

output gdiff "db(at(v(od), 1000))"
output gse "db(at(v(outp), 1000))"

code ac spice
  | VDD vdd 0 1.8
  | VCM cm 0 0.9
  | Vinp inp cm dc 0 ac 0.5
  | Vinn inn cm dc 0 ac -0.5
  | RL1 vdd outp 10k
  | RL2 vdd outn 10k
  | Itail tail 0 100u
  | Ediff od 0 outp outn 1
  | .ac dec 10 1k 10g
