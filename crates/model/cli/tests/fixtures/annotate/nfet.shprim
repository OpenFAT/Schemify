schemify 1 shprim
  doc "sky130 nfet_01v8 as the PDK import writes it (W, L in microns; annotate fixture)"
  prefix M

pin D inout 20 -30
pin G in -20 0
pin S inout 20 30
pin B in 20 0

param W 1
param L 0.15

impl spice spice
  format spice "X{name} {D} {G} {S} {B} sky130_fd_pr__nfet_01v8 w={W} l={L}"

rect -10 -30 20 30
