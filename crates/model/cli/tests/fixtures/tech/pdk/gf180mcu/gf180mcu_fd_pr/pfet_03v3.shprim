schemify 1 shprim
  doc "test stand-in for the imported gf180mcu_fd_pr pfet_03v3 (W, L in metres)"
  prefix X

pin D inout 20 30
pin G in -20 0
pin S inout 20 -30
pin B in 20 0

param L 0.28u
param W 0.22u
param nf 1
param m 1
param model pfet_03v3
  kind string

impl spice spice
  format spice "X{name} {D} {G} {S} {B} {model} L={L} W={W} nf={nf} m={m}"

rect -10 -30 20 30
