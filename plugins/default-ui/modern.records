# Schemify "Modern" preset: style overrides appended after ui.records while View → Modern theme
# is checked (the default-UI plugin re-contributes `UI + MODERN`; later edits win). Nodes, keys
# and accelerators are untouched (D25): only colours, borders and spacing change.
# Tokens and the gate: .claude/skills/schemify-theme (check_theme.py ui.records modern.records).
# ponytail: one chrome palette (dark) for both canvas themes; per-theme chrome needs the app to
# pick `<selector>.light` the way it picks canvas.<theme>.

set view.theme_modern checked 1

# --- chrome: neutral greys, one accent (4c8dff) -----------------------------------------------------

style *
  fg d4d7dc
  accel-fg 8b919a
  hover-bg 2a2e35
  active-bg 2f343c
  border-color 3a3f48

style window
  bg 15171b

style menubar
  bg 1e2127

style menu-title
  hover-bg 2a2e35
  active-bg 2f343c

style menubar-dash
  fg 5a606a

style menubar-button
  bg 1e2127
  hover-bg 2a2e35

style menu
  bg 23262c
  border-color 3a3f48

style item
  hover-bg 2f343c

style separator
  fg 3a3f48

style toolbar
  bg 1e2127

style button
  hover-bg 2f343c
  radius 4

style tabs
  bg 1e2127

style tab
  bg 1e2127
  fg 8b919a
  active-bg 2f343c
  active-fg ffffff
  border 0

style tab-new
  bg 1e2127
  fg 8b919a
  border 0

style canvas
  bg 15171b

style status
  bg 1e2127

style status-field
  bg 15171b
  border-color 3a3f48

style text_input
  bg 15171b
  border-color 3a3f48

style text_area
  bg 15171b
  border-color 3a3f48

style dialog
  bg 23262c
  border-color 3a3f48
  radius 6

style dialog-button
  bg 2f343c
  hover-bg 3a3f48
  radius 4

style ctx-menu
  bg 23262c
  border-color 3a3f48

style list-row
  hover-bg 2f343c
  active-bg 2f4a7a

style keys-panel
  bg 23262c

style view-switch
  bg 23262c
  border-color 3a3f48
  radius 6

style viewsw
  bg 23262c
  fg 8b919a
  hover-bg 2f343c
  hover-fg ffffff

style viewsw-on
  bg 2f4a7a
  fg ffffff
  hover-bg 2f4a7a

style viewsw-off
  fg 4a4f57
  hover-bg 23262c

