; PDK devices with CDF and simInfo (spec interop.md §6.3), as SfyExportLib writes them.
("sfyx" 1 "SfyExportLib test")
("lib" "gpdk")
("cell" "nmos1v" "ref")
("cdf" "-model w l nf")
("param" "model" "string" "g45n1svt" "Model name" "" ("storeDefault") () "")
("param" "w" "string" "120n" "Total width" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "gpdkMosW()")
("param" "l" "string" "45n" "Length" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "nf" "int" "1" "Fingers" "" () () "")
("param" "m" "string" "1" "Multiplier" "" ("parseAsNumber" "parseAsCEL") () "")
("param" "fingers" "radio" "1" "Finger mode" "" () ("1" "2") "")
("param" "ad" "string" "iPar(\"w\")*90n" "Drain area" "" ("parseAsNumber" "parseAsCEL") () "")
("param" "bodytie" "button" "" "Body tie" "" () () "")
("param" "sub" "netSet" "gnd!" "Substrate" "" ("storeDefault") () "")
("siminfo" "spectre" (("otherParameters" ("model")) ("instParameters" ("w" "l" "nf" "m" "ad")) ("termOrder" ("D" "G" "S" "B")) ("termMapping" (("D" ":d") ("G" ":g") ("S" ":s") ("B" ":b")))))
("siminfo" "auCdl" (("netlistProcedure" "ansCdlCompPrim") ("componentName" "nmos") ("termOrder" ("D" "G" "S" "B")) ("instParameters" ("m" "L" "W")) ("propMapping" (("L" "l") ("W" "w"))) ("namePrefix" "M") ("modelName" "g45n1svt")))
("cv" "symbol" "schematicSymbol" 160)
("term" "B" "inputOutput" "")
("term" "D" "inputOutput" "")
("term" "G" "input" "")
("term" "S" "inputOutput" "")
("pinfig" 1 "B" 18 -2 22 2)
("pinfig" 2 "D" 18 28 22 32)
("pinfig" 3 "G" -22 -2 -18 2)
("pinfig" 4 "S" 18 -32 22 -28)
("label" 5 0 "cdsName()" 25 8 "R0" "lowerLeft" "stick" 6 "IL" "annotate" "drawing7")
("label" 6 0 "cdsParam(1)" 25 -2 "R0" "lowerLeft" "stick" 6 "IL" "annotate" "drawing")
("shape" 7 "line" "device" "drawing" (-20 0 0 0) 0)
("shape" 8 "line" "device" "drawing" (5 15 20 15 20 30) 0)
("shape" 9 "line" "device" "drawing" (5 -15 20 -15 20 -30) 0)
("cell" "rpoly" "ref")
("cdf" "r")
("param" "r" "string" "1k" "Resistance" "resistance" ("parseAsNumber" "parseAsCEL") () "")
("param" "w" "string" "1u" "Width" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "l" "string" "10u" "Length" "lengthMetric" ("parseAsNumber" "parseAsCEL") () "")
("param" "kind" "string" "" "Kind" "" () () "")
("siminfo" "spectre" (("componentName" "resistor") ("instParameters" ("r" "w" "l" "kind")) ("termOrder" ("PLUS" "MINUS"))))
("siminfo" "auCdl" (("netlistProcedure" "ansCdlCompPrim") ("termOrder" ("PLUS" "MINUS")) ("instParameters" ("W" "L")) ("propMapping" (("W" "w") ("L" "l"))) ("namePrefix" "R") ("modelName" "RP")))
("cv" "symbol" "schematicSymbol" 160)
("term" "MINUS" "inputOutput" "")
("term" "PLUS" "inputOutput" "")
("pinfig" 1 "MINUS" -2 -32 2 -28)
("pinfig" 2 "PLUS" -2 28 2 32)
("shape" 3 "rect" "device" "drawing" (-6 -20 6 20) 0)
("end")
